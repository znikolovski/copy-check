# Copy to .env (never commit .env). `aio app use` adds AIO_runtime_* values.

# 32 random bytes, base64. Wraps the per-site data keys that encrypt each site's Sapling key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it makes stored keys unreadable, so site admins must set them again.
COPYCHECK_ENCRYPTION_KEY=
